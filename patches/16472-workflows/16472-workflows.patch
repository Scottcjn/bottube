+          if [ "$code" = 1 ]; then
+            echo "::error::A CI job FAILED on a step of your code. Look at the failing job's logs above - that is a real failure."
+          fi
+          if [ "$infra" = 0 ] && [ "$code" = 0 ]; then
             echo "All CI jobs completed successfully."
           fi
+          if [ "$infra" = 1 ] || [ "$code" = 1 ]; then exit 1; fi
diff --git a/.github/workflows/labeler.yml b/.github/workflows/labeler.yml
index 5e12294..f72e71a 100644
--- a/.github/workflows/labeler.yml
+++ b/.github/workflows/labeler.yml
@@ -23,8 +23,25 @@ jobs:
     timeout-minutes: 5
     steps:
       - uses: actions/labeler@v5
+        id: labeler
         with:
           repo-token: "${{ secrets.GITHUB_TOKEN }}"
           configuration-path: .github/labeler.yml
           sync-labels: false
         timeout-minutes: 4
+
+      # Bounty rustchain-bounties#16472: a red `label` check with no
+      # explanation is what made contributors chase failures that were never
+      # theirs (bottube#1639/#1640). State which kind of failure this is.
+      - name: Explain label failure
+        if: always()
+        timeout-minutes: 1
+        env:
+          LABELER_OUTCOME: ${{ steps.labeler.outcome }}
+        run: |
+          if [ "$LABELER_OUTCOME" = success ]; then exit 0; fi
+          if [ "$LABELER_OUTCOME" = cancelled ]; then
+            echo "::error::The auto-label step timed out after 4 minutes. That is a GitHub Actions/labeler hang, NOT a problem with your PR - re-run the label job."
+          else
+            echo "::error::The auto-label step failed for a non-timeout reason (usually an Actions outage or labeler config). Your PR code is not the cause; check this job's log before touching anything."
+          fi
