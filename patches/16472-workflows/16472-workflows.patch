-          else
+          echo "results: lint=[$LINT] test=[$TEST] security=[$SECURITY] deployment_drift=[$DRIFT]"
+          infra=0
+          code=0
+          echo "| job | result | what it means for you |" >> "$GITHUB_STEP_SUMMARY"
+          echo "|---|---|---|" >> "$GITHUB_STEP_SUMMARY"
+          for entry in "lint|$LINT" "test|$TEST" "security|$SECURITY" "deployment-drift|$DRIFT"; do
+            name="${entry%%|*}"
+            rest="${entry#*|}"
+            result="${rest%% *}"
+            kind="${rest#* }"
+            if [ "$result" = success ]; then
+              cls="ok"
+            elif [ "$result" = cancelled ]; then
+              cls="**timed out or cancelled before finishing - CI infrastructure, not your code. Re-run this job.**"; infra=1
+            elif [ "$kind" = step_timeout_or_infra ]; then
+              cls="**a checkout/setup/install step hit its timeout - CI infrastructure hang, not your code. Re-run this job.**"; infra=1
+            elif [ "$kind" = "$result" ] || [ -z "$kind" ]; then
+              cls="**failed before any step reported a result (runner or action-download outage) - CI infrastructure, not your code. Re-run this job.**"; infra=1
+            else
+              cls="failed on a step of your code - real failure; see the job log above"; code=1
+            fi
+            echo "| $name | $result | $cls |" >> "$GITHUB_STEP_SUMMARY"
+          done
+          if [ "$infra" = 1 ]; then
